# Public browser configuration — use the existing project publishable/anon key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-publishable-or-anon-key

# Optional server-side mail service. Set these in Vercel, never as VITE_ variables.
# The public form always prepares a mailto draft by design.
# These optional settings apply only to the retained server email endpoint.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=info@kortio.app
MAIL_TO=info@kortio.app
